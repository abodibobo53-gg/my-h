        ],
        finishLine: { x: 820, y: 340, width: 40, height: 100 }
    },
    {
        platforms: [
            { x: 0, y: 440, width: 180, height: 60, type: 'ground' },
            { x: 260, y: 380, width: 100, height: 30, type: 'block' },
            { x: 420, y: 320, width: 100, height: 30, type: 'block' },
            { x: 580, y: 260, width: 120, height: 30, type: 'block' },
            { x: 750, y: 440, width: 150, height: 60, type: 'ground' }
        ],
        spikes: [{ x: 620, y: 235, width: 30, height: 25 }],
        coins: [
            { x: 280, y: 335, width: 20, height: 20, collected: false },
            { x: 440, y: 275, width: 20, height: 20, collected: false },
            { x: 600, y: 215, width: 20, height: 20, collected: false }
        ],
        monsters: [
            { x: 270, y: 345, width: 35, height: 35, speed: 1.5, minX: 260, maxX: 330, alive: true },
            { x: 770, y: 400, width: 35, height: 35, speed: 3, minX: 750, maxX: 870, alive: true }
        ],
        finishLine: { x: 840, y: 340, width: 40, height: 100 }
    }
];

const player = {
    x: 50,
    y: 350,
    lastSafeX: 50,
    lastSafeY: 350,
    width: 35,
    height: 48,
    dx: 0,
    dy: 0,
    speed: 5.5,
    gravity: 0.75,
    jumpPower: -13.5,
    isGrounded: false,
    direction: 'right',
    lives: 3,
    invulnerable: 0,
    shootCooldown: 0
};

const acorns = [];
let score = 0;

function showMainMenu() {
    document.getElementById('main-menu').classList.remove('hidden');
    document.getElementById('level-menu').classList.add('hidden');
    gameState = 'MENU';
}

function showLevelSelect() {
    document.getElementById('main-menu').classList.add('hidden');
    document.getElementById('level-menu').classList.remove('hidden');
}

function startGame(levelIdx) {
    currentLevelIndex = levelIdx;
    document.getElementById('main-menu').classList.add('hidden');
    document.getElementById('level-menu').classList.add('hidden');
    player.lives = 3;
    score = 0;
    resetPlayerPosition(50, 350);
    gameState = 'PLAYING';
    saveProgress();
}

function respawnAtCheckPoint() {
    player.x = player.lastSafeX;
    player.y = player.lastSafeY;
    player.dx = 0;
    player.dy = 0;
    player.invulnerable = 60;
}

function resetPlayerPosition(x, y) {
    player.x = x;
    player.y = y;
    player.lastSafeX = x;
    player.lastSafeY = y;
    player.dx = 0;
    player.dy = 0;
    player.invulnerable = 60;
}

function saveProgress() {
    localStorage.setItem('mario_saved_level', currentLevelIndex);
    localStorage.setItem('mario_saved_score', score);
}

function loadSavedGame() {
    const savedLvl = localStorage.getItem('mario_saved_level');
    const savedScore = localStorage.getItem('mario_saved_score');
    if (savedLvl !== null) {
        score = parseInt(savedScore) || 0;
        startGame(parseInt(savedLvl));
    } else {
        alert("لا يوجد حفظ سابق!");
    }
}

const keys = {};
window.addEventListener('keydown', e => keys[e.code] = true);
window.addEventListener('keyup', e => keys[e.code] = false);

function update() {
    if (gameState !== 'PLAYING') return;

    let currentLevel = levels[currentLevelIndex];

    if (player.invulnerable > 0) player.invulnerable--;
    if (player.shootCooldown > 0) player.shootCooldown--;

    if (keys['ArrowRight'] || keys['KeyD']) {
        player.dx = player.speed;
        player.direction = 'right';
    } else if (keys['ArrowLeft'] || keys['KeyA']) {
        player.dx = -player.speed;
        player.direction = 'left';
    } else {
        player.dx = 0;
    }

    if ((keys['ArrowUp'] || keys['KeyW'] || keys['Space']) && player.isGrounded) {
        player.dy = player.jumpPower;
        player.isGrounded = false;
    }

    if ((keys['ShiftLeft'] || keys['ShiftRight'] || keys['KeyX']) && player.shootCooldown === 0) {
        acorns.push({
            x: player.direction === 'right' ? player.x + player.width : player.x - 15,
            y: player.y + 15,
            width: 14,
            height: 14,
            speed: player.direction === 'right' ? 8 : -8
        });
        player.shootCooldown = 15;
    }

    acorns.forEach((acorn, index) => {
        acorn.x += acorn.speed;
        if (acorn.x < 0 || acorn.x > canvas.width) acorns.splice(index, 1);

        currentLevel.monsters.forEach(m => {
            if (m.alive &&
                acorn.x < m.x + m.width &&
                acorn.x + acorn.width > m.x &&
                acorn.y < m.y + m.height &&
                acorn.y + acorn.height > m.y) {
                m.alive = false;
                score += 50;
                acorns.splice(index, 1);
            }
        });
    });

    player.dy += player.gravity;
    player.x += player.dx;
    player.y += player.dy;

    player.isGrounded = false;
    currentLevel.platforms.forEach(p => {
        if (
            player.x < p.x + p.width &&
            player.x + player.width > p.x &&
            player.y + player.height <= p.y + player.dy + 10 &&
            player.y + player.height >= p.y
        ) {
            player.dy = 0;
            player.y = p.y - player.height;
            player.isGrounded = true;
            player.lastSafeX = player.x;
            player.lastSafeY = player.y;
        }
    });

    let f = currentLevel.finishLine;
    if (player.x < f.x + f.width &&
        player.x + player.width > f.x &&
        player.y < f.y + f.height &&
        player.y + player.height > f.y) {
        
        if (currentLevelIndex < levels.length - 1) {
            currentLevelIndex++;
            saveProgress();
            resetPlayerPosition(50, 350);
        } else {
            gameState = 'WON';
        }
    }

    currentLevel.monsters.forEach(m => {
        if (!m.alive) return;
        m.x += m.speed;
        if (m.x <= m.minX || m.x + m.width >= m.maxX) m.speed *= -1;

        if (player.x < m.x + m.width &&
            player.x + player.width > m.x &&
            player.y < m.y + m.height &&
            player.y + player.height > m.y) {
            
            if (player.dy > 0 && player.y + player.height - player.dy <= m.y + 12) {
                m.alive = false;
                player.dy = player.jumpPower / 1.5;
                score += 50;
            } else if (player.invulnerable === 0) {
                player.lives--;
                if(player.lives > 0) respawnAtCheckPoint();
                else gameState = 'GAMEOVER';
            }
        }
    });

    currentLevel.spikes.forEach(s => {
        if (player.invulnerable === 0 &&
            player.x < s.x + s.width &&
            player.x + player.width > s.x &&
            player.y < s.y + s.height &&
            player.y + player.height > s.y) {
            player.lives--;
            if(player.lives > 0) respawnAtCheckPoint();
            else gameState = 'GAMEOVER';
        }
    });

    currentLevel.coins.forEach(coin => {
        if (!coin.collected &&
            player.x < coin.x + coin.width &&
            player.x + player.width > coin.x &&
            player.y < coin.y + coin.height &&
            player.y + player.height > coin.y) {
            coin.collected = true;
            score += 10;
        }
    });

    if (player.y > canvas.height) {
        player.lives--;
        if(player.lives > 0) respawnAtCheckPoint();
        else gameState = 'GAMEOVER';
    }

    if (player.x < 0) player.x = 0;
    if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;
}

function drawPlayer(x, y, w, h, dir) {
    ctx.fillStyle = '#2ecc71';
    ctx.fillRect(x + 5, y + 20, w - 10, h - 20);
    ctx.fillStyle = '#ffdbac';
    ctx.fillRect(x + 5, y + 8, w - 10, 14);
    ctx.fillStyle = '#27ae60';
    ctx.fillRect(x + 2, y, w - 4, 10);
    ctx.fillRect(dir === 'right' ? x + 10 : x - 2, y + 7, w - 8, 4);
    ctx.fillStyle = '#000';
    let eyeX = dir === 'right' ? x + w - 12 : x + 8;
    ctx.fillRect(eyeX, y + 12, 4, 4);
    ctx.fillStyle = '#e67e22';
    ctx.fillRect(x + 3, y + h - 6, 12, 6);
    ctx.fillRect(x + w - 15, y + h - 6, 12, 6);
}

function drawMonster(x, y, w, h) {
    ctx.fillStyle = '#e74c3c';
    ctx.beginPath();
    ctx.arc(x + w/2, y + h/2, w/2, Math.PI, 0, false);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.fillRect(x + 8, y + 6, 5, 5);
    ctx.fillRect(x + w - 13, y + 6, 5, 5);
    ctx.fillStyle = '#f39c12';
    ctx.fillRect(x + 6, y + h/2, w - 12, h/2);
    ctx.fillStyle = '#000';
    ctx.fillRect(x + 10, y + h/2 + 4, 3, 6);
    ctx.fillRect(x + w - 13, y + h/2 + 4, 3, 6);
}

function drawAcorn(x, y, w, h) {
    ctx.fillStyle = '#d35400';
    ctx.beginPath();
    ctx.arc(x + w/2, y + h/2, w/2, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#6e2c00';
    ctx.fillRect(x, y, w, h/3);
}

function drawCoin(x, y, w, h) {
    ctx.fillStyle = '#f1c40f';
    ctx.beginPath();
    ctx.arc(x + w/2, y + h/2, w/2, 0, Math.PI * 2);
    ctx.fill();
}

function drawSpike(x, y, w, h) {
    ctx.fillStyle = '#7f8c8d';
    ctx.beginPath();
    ctx.moveTo(x, y + h);
    ctx.lineTo(x + w/2, y);
    ctx.lineTo(x + w, y + h);
    ctx.closePath();
    ctx.fill();
}

function drawFinishLine(x, y, w, h) {
    ctx.fillStyle = '#bdc3c7';
    ctx.fillRect(x + 10, y, 6, h);
    ctx.fillStyle = '#e74c3c';
    ctx.beginPath();
    ctx.moveTo(x + 16, y);
    ctx.lineTo(x + 40, y + 15);
    ctx.lineTo(x + 16, y + 30);
    ctx.closePath();
    ctx.fill();
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (gameState === 'MENU') return;

    let currentLevel = levels[currentLevelIndex];

    currentLevel.platforms.forEach(p => {
        ctx.fillStyle = p.type === 'ground' ? '#27ae60' : '#d35400';
        ctx.fillRect(p.x, p.y, p.width, p.height);
        if (p.type === 'ground') {
            ctx.fillStyle = '#2ecc71';
            ctx.fillRect(p.x, p.y, p.width, 6);
        }
    });

    drawFinishLine(currentLevel.finishLine.x, currentLevel.finishLine.y, currentLevel.finishLine.width, currentLevel.finishLine.height);
    currentLevel.spikes.forEach(s => drawSpike(s.x, s.y, s.width, s.height));
    currentLevel.coins.forEach(c => { if (!c.collected) drawCoin(c.x, c.y, c.width, c.height); });
    currentLevel.monsters.forEach(m => { if (m.alive) drawMonster(m.x, m.y, m.width, m.height); });
    acorns.forEach(a => drawAcorn(a.x, a.y, a.width, a.height));

    if (player.invulnerable % 10 < 5) {
        drawPlayer(player.x, player.y, player.width, player.height, player.direction);
    }

    for (let i = 0; i < player.lives; i++) {
        ctx.fillStyle = '#e74c3c';
        ctx.beginPath();
        ctx.arc(30 + (i * 30), 30, 8, 0, Math.PI * 2);
        ctx.fill();
    }

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 18px sans-serif";
    ctx.fillText("🪙 " + score, 130, 35);
    ctx.fillText("🗺️ المرحلة: " + (currentLevelIndex + 1), 220, 35);

    if (gameState === 'WON') {
        ctx.fillStyle = "rgba(0, 0, 0, 0.85)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#2ecc71";
        ctx.font = "bold 45px sans-serif";
        ctx.fillText("🏆 ختمت اللعبة بالكامل! 🏆", canvas.width/2 - 230, canvas.height/2 - 20);
    }

    if (gameState === 'GAMEOVER') {
        ctx.fillStyle = "rgba(0, 0, 0, 0.85)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#e74c3c";
        ctx.font = "bold 45px sans-serif";
        ctx.fillText("GAME OVER", canvas.width/2 - 130, canvas.height/2 - 20);
    }
}

function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
}

gameLoop();
</script>

</body>
</html>"""

with open("mario.html", "w", encoding="utf-8") as f:
    f.write(html_code)

